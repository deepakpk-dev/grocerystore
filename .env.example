# Google Sheets — populated in Phase 1
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Base64-encoded private key (paste into Vercel env vars as-is)
GOOGLE_SERVICE_ACCOUNT_KEY=

# Shared secret guarding the manual /api/refresh endpoint
REFRESH_TOKEN=

# Random 16+ character secret automatically sent by Vercel Cron as a Bearer token
CRON_SECRET=

# Canonical production origin, for example https://manokara-stores.vercel.app
NEXT_PUBLIC_SITE_URL=

# Set automatically by the Vercel Blob integration
BLOB_READ_WRITE_TOKEN=

# Set to "1" after replacing all mock business data
NEXT_PUBLIC_HIDE_MOCK_RIBBON=
